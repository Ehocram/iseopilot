[Unit]
Description=Agente di deploy ISEOPilot (solo /opt/iseopilot, solo servizio iseopilot)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/iseopilot/tools/deploy_agent/agente.py
Restart=on-failure
RestartSec=5

# Deve poter usare git e docker sull'host: gira come root, ed e' esattamente
# il motivo per cui NON sta dentro il container e ascolta solo su localhost.
User=root
WorkingDirectory=/opt/iseopilot

# Il socket vive in /run/iseopilot, montato nel container: systemd crea la
# cartella e la ripulisce a ogni riavvio.
# 0755: l'utente del container (uid 10001) deve poter ATTRAVERSARE la cartella
# per arrivare al socket. Il controllo d'accesso sta sul socket, che e'
# 0660 root:10001 — non sulla cartella.
RuntimeDirectory=iseopilot
RuntimeDirectoryMode=0755

Environment=DEPLOY_AGENT_SOCKET=/run/iseopilot/deploy-agent.sock
Environment=DEPLOY_AGENT_GID=10001
Environment=DEPLOY_AGENT_TOKEN_FILE=/etc/iseopilot/deploy-agent.token
Environment=DEPLOY_AGENT_LOG=/var/log/iseopilot-deploy.log

# Riduzione della superficie: niente nuovi privilegi, /home e /tmp isolati.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
